<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DateCountdown</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <IncludeCustomOutputGroupForPackaging>true</IncludeCustomOutputGroupForPackaging>
    <Nullable>enable</Nullable>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="Assets\Win10StyleBackup\**" />
    <None Remove="Assets\Win10StyleBackup\**" />
    <Content Remove="Assets\*.backup.*" />
    <None Remove="Assets\*.backup.*" />
    <Content Include="Assets\*.png;Assets\*.ico" Exclude="Assets\*.backup.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DateCountdown.Cli\DateCountdown.Cli.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\DateCountdown.Core\DateCountdown.Core.csproj" />
    <ProjectReference Include="..\DateCountdown.WidgetProvider\DateCountdown.WidgetProvider.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">False</PublishTrimmed>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxPackageSigningEnabled>False</AppxPackageSigningEnabled>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
    <GenerateTestArtifacts>False</GenerateTestArtifacts>
    <AppxBundle>Auto</AppxBundle>
    <AppxBundlePlatforms>x86|x64|arm64</AppxBundlePlatforms>
    <GenerateTemporaryStoreCertificate>False</GenerateTemporaryStoreCertificate>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
  </PropertyGroup>

  <Target Name="AddDateCountdownPackagePayload" BeforeTargets="CustomOutputGroupForPackaging" DependsOnTargets="ResolveProjectReferences">
    <MSBuild Projects="..\DateCountdown.WidgetProvider\DateCountdown.WidgetProvider.csproj" Targets="GetTargetPath" BuildInParallel="$(BuildInParallel)" Properties="Configuration=$(Configuration);Platform=$(Platform)">
      <Output TaskParameter="TargetOutputs" ItemName="_WidgetProviderTargetPath" />
    </MSBuild>
    <MSBuild Projects="..\DateCountdown.Cli\DateCountdown.Cli.csproj" Targets="GetTargetPath" BuildInParallel="$(BuildInParallel)" Properties="Configuration=$(Configuration);Platform=$(Platform)">
      <Output TaskParameter="TargetOutputs" ItemName="_CountdownCliTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <WidgetProviderOutput>@(_WidgetProviderTargetPath->'%(RootDir)%(Directory)')</WidgetProviderOutput>
      <CountdownCliOutput>@(_CountdownCliTargetPath->'%(RootDir)%(Directory)')</CountdownCliOutput>
    </PropertyGroup>
    <ItemGroup>
      <_WidgetProviderPackagePayload Include="$(WidgetProviderOutput)**\*.*" />
      <_CountdownCliPackagePayload Include="$(CountdownCliOutput)DateCountdown.Cli.exe;$(CountdownCliOutput)DateCountdown.Cli.dll;$(CountdownCliOutput)DateCountdown.Cli.deps.json;$(CountdownCliOutput)DateCountdown.Cli.runtimeconfig.json" />
      <CustomOutputGroupForPackagingOutput Include="@(_WidgetProviderPackagePayload)">
        <TargetPath>DateCountdown.WidgetProvider\%(_WidgetProviderPackagePayload.RecursiveDir)%(_WidgetProviderPackagePayload.Filename)%(_WidgetProviderPackagePayload.Extension)</TargetPath>
      </CustomOutputGroupForPackagingOutput>
      <CustomOutputGroupForPackagingOutput Include="@(_CountdownCliPackagePayload)">
        <TargetPath>%(_CountdownCliPackagePayload.Filename)%(_CountdownCliPackagePayload.Extension)</TargetPath>
      </CustomOutputGroupForPackagingOutput>
    </ItemGroup>
  </Target>
</Project>
