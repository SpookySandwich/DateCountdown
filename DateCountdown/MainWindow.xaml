<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="DateCountdown.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid
        x:Name="RootGrid"
        Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Background="Transparent" />

        <Grid
            x:Name="CountdownSelectorFrame"
            Grid.Row="1"
            Canvas.ZIndex="1"
            Margin="32,8,32,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Visibility="Collapsed">
            <Grid.Transitions>
                <TransitionCollection>
                    <RepositionThemeTransition />
                </TransitionCollection>
            </Grid.Transitions>
            <ScrollViewer
                x:Name="CountdownSelectorRail"
                HorizontalAlignment="Stretch"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Enabled"
                PointerCanceled="CountdownSelectorRail_PointerCanceled"
                PointerMoved="CountdownSelectorRail_PointerMoved"
                PointerPressed="CountdownSelectorRail_PointerPressed"
                PointerReleased="CountdownSelectorRail_PointerReleased"
                PointerWheelChanged="CountdownSelectorRail_PointerWheelChanged"
                SizeChanged="CountdownSelectorRail_SizeChanged"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled">
                <Grid x:Name="CountdownSelectorContentHost">
                    <StackPanel
                        x:Name="CountdownSelectorItems"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="18">
                        <StackPanel.ChildrenTransitions>
                            <TransitionCollection>
                                <RepositionThemeTransition />
                            </TransitionCollection>
                        </StackPanel.ChildrenTransitions>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <ScrollViewer
            x:Name="MainContentScroller"
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            SizeChanged="MainContentScroller_SizeChanged"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <ScrollViewer.RenderTransform>
                <TranslateTransform />
            </ScrollViewer.RenderTransform>
            <StackPanel
                x:Name="MainContentPanel"
                MaxWidth="390"
                MinWidth="296"
                Padding="32,36,32,40"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Spacing="26">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <StackPanel
                    x:Name="CountdownDisplayPanel"
                    HorizontalAlignment="Stretch"
                    Spacing="4">
                    <TextBlock
                        x:Name="TextBlockDays"
                        x:Uid="DaysLeft"
                        MaxWidth="560"
                        MinWidth="296"
                        AutomationProperties.AccessibilityView="Content"
                        AutomationProperties.LiveSetting="Polite"
                        FontFamily="Segoe UI Variable Display, Segoe UI"
                        FontSize="72"
                        FontWeight="Light"
                        HorizontalAlignment="Center"
                        MaxLines="2"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="TextBlockTitle"
                        MaxWidth="360"
                        AutomationProperties.AccessibilityView="Content"
                        FontSize="14"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"
                        Opacity="0.88"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <StackPanel
                    x:Name="InlineEditorPanel"
                    HorizontalAlignment="Stretch"
                    MaxWidth="360"
                    Opacity="0"
                    Spacing="10"
                    Visibility="Collapsed"
                    AutomationProperties.AutomationId="InlineCountdownEditor">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>
                    <TextBlock
                        x:Name="EditorTitleText"
                        FontSize="12"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"
                        Opacity="0.68"
                        TextAlignment="Center"
                        TextWrapping="WrapWholeWords"
                        Visibility="Collapsed" />
                    <TextBox
                        x:Name="TextBoxTitle"
                        AutomationProperties.AutomationId="CountdownTitleTextBox"
                        HorizontalAlignment="Stretch"
                        TextChanged="TextBoxTitle_TextChanged"
                        TextWrapping="Wrap" />
                    <Grid
                        MinHeight="32"
                        VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="DateEditorHeaderText"
                            VerticalAlignment="Center"
                            FontSize="15"
                            TextWrapping="WrapWholeWords" />
                        <StackPanel
                            x:Name="EditorExtraOptionsButtons"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="6">
                            <ToggleButton
                                x:Name="EditorTimeOptionsButton"
                                Width="34"
                                Height="32"
                                Padding="0"
                                AutomationProperties.AutomationId="EditorTimeOptionsButton"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="EditorTimeOptionsButton_Click"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    FontSize="15"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Glyph="&#xE823;" />
                            </ToggleButton>
                            <ToggleButton
                                x:Name="EditorTimeZoneOptionsButton"
                                Width="34"
                                Height="32"
                                Padding="0"
                                AutomationProperties.AutomationId="EditorTimeZoneOptionsButton"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="EditorTimeZoneOptionsButton_Click"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    FontSize="15"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Glyph="&#xE774;" />
                            </ToggleButton>
                        </StackPanel>
                    </Grid>
                    <CalendarDatePicker
                        x:Name="DatePickerTargetDate"
                        AutomationProperties.AutomationId="TargetDatePicker"
                        DateChanged="DatePickerTargetDate_SelectedDateChanged"
                        HorizontalAlignment="Stretch" />
                    <TimePicker
                        x:Name="TimePickerTargetTime"
                        AutomationProperties.AutomationId="TargetTimePicker"
                        ClockIdentifier="24HourClock"
                        HorizontalAlignment="Stretch"
                        Opacity="0"
                        TimeChanged="TimePickerTargetTime_TimeChanged"
                        Visibility="Collapsed" />
                    <ComboBox
                        x:Name="ComboBoxTargetTimeZone"
                        AutomationProperties.AutomationId="TargetTimeZoneComboBox"
                        HorizontalAlignment="Stretch"
                        Opacity="0"
                        SelectionChanged="ComboBoxTargetTimeZone_SelectionChanged"
                        Visibility="Collapsed" />
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Center"
                    Spacing="8">
                    <StackPanel
                        x:Name="ToggleButtons"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="NotifyButton"
                            Width="40"
                            Height="40"
                            Padding="0"
                            AutomationProperties.AutomationId="StartupNotificationToggle"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="NotifyButton_Click">
                            <Button.Resources>
                                <SolidColorBrush
                                    x:Key="ButtonBackgroundDisabled"
                                    Color="Transparent" />
                                <SolidColorBrush
                                    x:Key="ButtonBorderBrushDisabled"
                                    Color="Transparent" />
                            </Button.Resources>
                            <Button.RenderTransform>
                                <TranslateTransform />
                            </Button.RenderTransform>
                            <FontIcon
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                FontSize="16"
                                Glyph="&#xE7E7;" />
                        </Button>
                        <Button
                            x:Name="TileButton"
                            Width="40"
                            Height="40"
                            Padding="0"
                            AutomationProperties.AutomationId="GlanceSurfaceButton"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="TileButton_Click">
                            <Button.RenderTransform>
                                <TranslateTransform />
                            </Button.RenderTransform>
                            <FontIcon
                                x:Name="GlanceSurfaceIcon"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="16"
                                Glyph="&#xECA5;" />
                        </Button>
                        <Button
                            x:Name="DeleteButton"
                            Width="40"
                            Height="40"
                            Opacity="0"
                            Padding="0"
                            AutomationProperties.AutomationId="DeleteCountdownButton"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="DeleteButton_Click"
                            IsHitTestVisible="False"
                            IsTabStop="False"
                            Visibility="Collapsed">
                            <Button.RenderTransform>
                                <TranslateTransform />
                            </Button.RenderTransform>
                            <FontIcon
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                FontSize="16"
                                Glyph="&#xE74D;" />
                        </Button>
                        <Button
                            x:Name="CancelEditorButton"
                            Width="40"
                            Height="40"
                            Opacity="0"
                            Padding="0"
                            AutomationProperties.AutomationId="CancelEditorButton"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="CancelEditorButton_Click"
                            IsHitTestVisible="False"
                            IsTabStop="False"
                            Visibility="Collapsed">
                            <Button.RenderTransform>
                                <TranslateTransform />
                            </Button.RenderTransform>
                            <FontIcon
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                FontSize="16"
                                Glyph="&#xE711;" />
                        </Button>
                        <Button
                            x:Name="SaveEditorButton"
                            Width="40"
                            Height="40"
                            Opacity="0"
                            Padding="0"
                            AutomationProperties.AutomationId="SaveEditorButton"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="SaveEditorButton_Click"
                            IsHitTestVisible="False"
                            IsTabStop="False"
                            Visibility="Collapsed">
                            <Button.RenderTransform>
                                <TranslateTransform />
                            </Button.RenderTransform>
                            <FontIcon
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                FontSize="16"
                                Glyph="&#xE73E;" />
                        </Button>
                        <Button
                            x:Name="EditButton"
                            Width="40"
                            Height="40"
                            Padding="0"
                            AutomationProperties.AutomationId="EditCountdownButton"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="EditButton_Click">
                            <Button.RenderTransform>
                                <TranslateTransform />
                            </Button.RenderTransform>
                            <FontIcon
                                x:Name="EditButtonIcon"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                FontSize="16"
                                Glyph="&#xE70F;" />
                        </Button>
                        <Button
                            x:Name="AddButton"
                            Width="40"
                            Height="40"
                            Padding="0"
                            AutomationProperties.AutomationId="AddCountdownButton"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="AddButton_Click">
                            <Button.RenderTransform>
                                <TranslateTransform />
                            </Button.RenderTransform>
                            <FontIcon
                                x:Name="AddButtonIcon"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                FontSize="16"
                                Glyph="&#xE710;" />
                        </Button>
                        <Button
                            x:Name="DesktopOverlayButton"
                            Width="40"
                            Height="40"
                            Padding="0"
                            AutomationProperties.AutomationId="DesktopOverlayButton"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="DesktopCountdownButton_Click">
                            <Button.RenderTransform>
                                <TranslateTransform />
                            </Button.RenderTransform>
                            <FontIcon
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                FontSize="16"
                                Glyph="&#xE7F4;" />
                        </Button>
                        <Button
                            x:Name="MoreButton"
                            Width="40"
                            Height="40"
                            Padding="0"
                            AutomationProperties.AutomationId="MoreButton"
                            Background="Transparent"
                            BorderThickness="0">
                            <Button.RenderTransform>
                                <TranslateTransform />
                            </Button.RenderTransform>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        x:Name="NotifyMenuItem"
                                        Click="NotifyMenuItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon
                                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                Glyph="&#xE7E7;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        x:Name="TileMenuItem"
                                        Click="TileMenuItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon
                                                x:Name="GlanceSurfaceMenuIcon"
                                                FontFamily="Segoe MDL2 Assets"
                                                Glyph="&#xECA5;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        x:Name="DeleteMenuItem"
                                        Click="DeleteMenuItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon
                                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                Glyph="&#xE74D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        x:Name="EditMenuItem"
                                        Click="EditMenuItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon
                                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                Glyph="&#xE70F;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        x:Name="AddMenuItem"
                                        Click="AddMenuItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon
                                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                            Glyph="&#xE710;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        x:Name="DesktopCountdownMenuItem"
                                        Click="DesktopCountdownMenuItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon
                                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                Glyph="&#xE7F4;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator x:Name="ToolbarActionsSeparator" />
                                    <MenuFlyoutItem
                                        x:Name="SettingsMenuItem"
                                        Click="SettingsMenuItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon
                                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                            Glyph="&#xE713;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                            <FontIcon
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                FontSize="16"
                                Glyph="&#xE712;" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer
            x:Name="SettingsContentScroller"
            Grid.Row="1"
            Canvas.ZIndex="2"
            Padding="18,4,18,32"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            SizeChanged="SettingsContentScroller_SizeChanged"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto"
            Visibility="Collapsed">
            <StackPanel
                x:Name="SettingsContentPanel"
                MaxWidth="640"
                MinWidth="360"
                HorizontalAlignment="Center"
                Spacing="28">
                <StackPanel
                    Spacing="16">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="SettingsBackButton"
                            Width="36"
                            Height="36"
                            Padding="0"
                            AutomationProperties.AutomationId="SettingsBackButton"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="SettingsBackButton_Click">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                FontSize="16"
                                Glyph="&#xE72B;" />
                        </Button>
                        <TextBlock
                            x:Name="SettingsTitleText"
                            VerticalAlignment="Center"
                            FontSize="22"
                            FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock
                            x:Name="SettingsCountdownsHeaderText"
                            FontSize="14"
                            FontWeight="SemiBold" />
                        <Border
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            CornerRadius="6">
                            <Grid Padding="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Grid.Column="0"
                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    FontSize="18"
                                    Glyph="&#xE8CB;"
                                    VerticalAlignment="Center" />
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock
                                        x:Name="SortCountdownsTitleText"
                                        FontWeight="SemiBold"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="SortCountdownsToggle"
                                    Grid.Column="2"
                                    Margin="16,0,0,0"
                                    AutomationProperties.AutomationId="SortCountdownsToggle"
                                    MinWidth="0"
                                    OffContent=""
                                    OnContent=""
                                    Toggled="SortCountdownsToggle_Toggled" />
                            </Grid>
                        </Border>
                        <Border
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            CornerRadius="6">
                            <Grid Padding="16" RowSpacing="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Grid.Column="0"
                                    Grid.RowSpan="2"
                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    FontSize="18"
                                    Glyph="&#xE74D;"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="AutoDeleteExpiredCountdownsTitleText"
                                    Grid.Column="1"
                                    FontWeight="SemiBold"
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    x:Name="AutoDeleteExpiredCountdownsDescriptionText"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    MaxWidth="440"
                                    Opacity="0.72"
                                    TextWrapping="WrapWholeWords" />
                                <ToggleSwitch
                                    x:Name="AutoDeleteExpiredCountdownsToggle"
                                    Grid.Column="2"
                                    Grid.RowSpan="2"
                                    Margin="16,0,0,0"
                                    AutomationProperties.AutomationId="AutoDeleteExpiredCountdownsToggle"
                                    MinWidth="0"
                                    OffContent=""
                                    OnContent=""
                                    VerticalAlignment="Center"
                                    Toggled="AutoDeleteExpiredCountdownsToggle_Toggled" />
                            </Grid>
                        </Border>
                        <Button
                            x:Name="ToolbarLayoutEntryButton"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="ToolbarLayoutEntryButton"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="ToolbarLayoutEntryButton_Click">
                            <Border
                                HorizontalAlignment="Stretch"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                CornerRadius="6">
                                <Grid
                                    MinHeight="72"
                                    Padding="16"
                                    RowSpacing="3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Grid.Column="0"
                                        Grid.RowSpan="2"
                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                        FontSize="18"
                                        Glyph="&#xE700;"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        x:Name="ToolbarLayoutTitleText"
                                        Grid.Column="1"
                                        FontWeight="SemiBold"
                                        TextWrapping="WrapWholeWords" />
                                    <TextBlock
                                        x:Name="ToolbarLayoutDescriptionText"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        MaxWidth="440"
                                        Opacity="0.72"
                                        TextWrapping="WrapWholeWords" />
                                    <FontIcon
                                        Grid.Column="2"
                                        Grid.RowSpan="2"
                                        Margin="16,0,0,0"
                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                        FontSize="14"
                                        Glyph="&#xE974;"
                                        Opacity="0.72"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Button>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock
                            x:Name="SettingsAppearanceHeaderText"
                            FontSize="14"
                            FontWeight="SemiBold" />
                        <Expander
                            x:Name="TextSizeExpander"
                            HorizontalAlignment="Stretch"
                            IsExpanded="False">
                            <Expander.Header>
                                <Grid MinHeight="56">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Grid.Column="0"
                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                        FontSize="18"
                                        Glyph="&#xE790;"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        x:Name="TextSizeTitleText"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold" />
                                </Grid>
                            </Expander.Header>
                            <StackPanel
                                Padding="56,0,16,18"
                                Spacing="14">
                                <Border
                                    Padding="16"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="6">
                                    <StackPanel
                                        HorizontalAlignment="Stretch"
                                        Spacing="4">
                                        <TextBlock
                                            x:Name="SettingsPreviewDaysText"
                                            MaxWidth="520"
                                            HorizontalAlignment="Center"
                                            FontFamily="Segoe UI Variable Display, Segoe UI"
                                            FontWeight="Light"
                                            MaxLines="2"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            x:Name="SettingsPreviewTitleText"
                                            HorizontalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Opacity="0.88"
                                            TextAlignment="Center"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Border>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="DaysTextSizeLabelText"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        x:Name="DaysTextSizeValueText"
                                        Grid.Column="1"
                                        Opacity="0.72" />
                                </Grid>
                                <Slider
                                    x:Name="DaysTextSizeSlider"
                                    SmallChange="1"
                                    StepFrequency="1"
                                    ValueChanged="DaysTextSizeSlider_ValueChanged" />

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="TitleTextSizeLabelText"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        x:Name="TitleTextSizeValueText"
                                        Grid.Column="1"
                                        Opacity="0.72" />
                                </Grid>
                                <Slider
                                    x:Name="TitleTextSizeSlider"
                                    SmallChange="1"
                                    StepFrequency="1"
                                    ValueChanged="TitleTextSizeSlider_ValueChanged" />
                            </StackPanel>
                        </Expander>
                        <Border
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            CornerRadius="6">
                            <StackPanel
                                Padding="16"
                                Spacing="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Grid.Column="0"
                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                        FontSize="18"
                                        Glyph="&#xE823;"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        x:Name="HourDisplayModeTitleText"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        TextWrapping="WrapWholeWords" />
                                    <ComboBox
                                        x:Name="HourDisplayModeComboBox"
                                        Grid.Column="2"
                                        Margin="16,0,0,0"
                                        MinWidth="220"
                                        AutomationProperties.AutomationId="HourDisplayModeComboBox"
                                        DisplayMemberPath="DisplayName"
                                        SelectionChanged="HourDisplayModeComboBox_SelectionChanged"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right" />
                                </Grid>
                                <Grid
                                    x:Name="HoursDisplayThresholdPanel"
                                    Margin="40,0,0,0"
                                    ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="128" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="HoursDisplayThresholdDaysLabelText"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        TextWrapping="WrapWholeWords" />
                                    <NumberBox
                                        x:Name="HoursDisplayThresholdDaysBox"
                                        Grid.Column="1"
                                        AcceptsExpression="False"
                                        AutomationProperties.AutomationId="HoursDisplayThresholdDaysBox"
                                        LargeChange="5"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Inline"
                                        ValueChanged="HoursDisplayThresholdDaysBox_ValueChanged" />
                                    <TextBlock
                                        x:Name="HoursDisplayThresholdDaysSuffixText"
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        TextWrapping="WrapWholeWords" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            CornerRadius="6">
                            <Grid Padding="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Grid.Column="0"
                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    FontSize="18"
                                    Glyph="&#xE776;"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="ReduceMotionTitleText"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    TextWrapping="WrapWholeWords" />
                                <ToggleSwitch
                                    x:Name="ReduceMotionToggle"
                                    Grid.Column="2"
                                    Margin="16,0,0,0"
                                    MinWidth="0"
                                    OffContent=""
                                    OnContent=""
                                    Toggled="ReduceMotionToggle_Toggled" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock
                            x:Name="SettingsStartupHeaderText"
                            FontSize="14"
                            FontWeight="SemiBold" />
                        <Border
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            CornerRadius="6">
                            <Grid Padding="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Grid.Column="0"
                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    FontSize="18"
                                    Glyph="&#xE8FB;"
                                    VerticalAlignment="Center" />
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock
                                        x:Name="OpenAtStartupTitleText"
                                        FontWeight="SemiBold"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="OpenAtStartupToggle"
                                    Grid.Column="2"
                                    Margin="16,0,0,0"
                                    MinWidth="0"
                                    OffContent=""
                                    OnContent=""
                                    Toggled="OpenAtStartupToggle_Toggled" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock
                            x:Name="SettingsExperimentalHeaderText"
                            FontSize="14"
                            FontWeight="SemiBold" />
                        <Grid>
                            <Border
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                CornerRadius="6" />
                            <Grid Padding="16" RowSpacing="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Viewbox
                                    Grid.Column="0"
                                    Grid.RowSpan="2"
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AccessibilityView="Raw">
                                    <Canvas
                                        Width="24"
                                        Height="24">
                                        <Path
                                            Data="M9,3 L15,3 M11,3 L11,8 L6,18 C5.6,18.8 6.2,20 7.1,20 L16.9,20 C17.8,20 18.4,18.8 18,18 L13,8 L13,3 M8,15 L16,15"
                                            Stroke="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            StrokeEndLineCap="Round"
                                            StrokeLineJoin="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeThickness="2" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock
                                    x:Name="ExperimentalFeaturesTitleText"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    x:Name="ExperimentalFeaturesDescriptionText"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    MaxWidth="440"
                                    Opacity="0.72"
                                    TextWrapping="WrapWholeWords" />
                                <ToggleSwitch
                                    x:Name="ExperimentalFeaturesToggle"
                                    Grid.Column="2"
                                    Grid.RowSpan="2"
                                    Margin="16,0,0,0"
                                    AutomationProperties.AutomationId="ExperimentalFeaturesToggle"
                                    MinWidth="0"
                                    OffContent=""
                                    OnContent=""
                                    VerticalAlignment="Center"
                                    Toggled="ExperimentalFeaturesToggle_Toggled" />
                            </Grid>
                            <Border
                                x:Name="ExperimentalFeaturesCardBorder"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                IsHitTestVisible="False"
                                Opacity="0" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock
                            x:Name="SettingsAboutHeaderText"
                            FontSize="14"
                            FontWeight="SemiBold" />
                        <Border
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            CornerRadius="6">
                            <Grid Padding="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image
                                    Grid.Column="0"
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Source="Assets/Square44x44Logo.targetsize-24.png" />
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock
                                        x:Name="AboutAppNameText"
                                        FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="AboutVersionText"
                                    Grid.Column="2"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    Opacity="0.72" />
                            </Grid>
                        </Border>
                        <HyperlinkButton
                            x:Name="SourceCodeLinkButton"
                            Padding="0"
                            NavigateUri="https://github.com/SpookySandwich/DateCountdown" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer
            x:Name="ToolbarLayoutContentScroller"
            Grid.Row="1"
            Canvas.ZIndex="2"
            Padding="18,4,18,32"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            SizeChanged="ToolbarLayoutContentScroller_SizeChanged"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto"
            Visibility="Collapsed">
            <StackPanel
                x:Name="ToolbarLayoutContentPanel"
                MaxWidth="640"
                MinWidth="360"
                HorizontalAlignment="Center"
                Spacing="24">
                <StackPanel Spacing="16">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="ToolbarLayoutBackButton"
                            Width="36"
                            Height="36"
                            Padding="0"
                            AutomationProperties.AutomationId="ToolbarLayoutBackButton"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="ToolbarLayoutBackButton_Click">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                FontSize="16"
                                Glyph="&#xE72B;" />
                        </Button>
                        <TextBlock
                            x:Name="ToolbarLayoutPageTitleText"
                            VerticalAlignment="Center"
                            FontSize="22"
                            FontWeight="SemiBold" />
                    </StackPanel>

                    <TextBlock
                        x:Name="ToolbarLayoutPageDescriptionText"
                        HorizontalAlignment="Left"
                        MaxWidth="540"
                        Opacity="0.72"
                        TextWrapping="WrapWholeWords" />

                    <Border
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="6">
                        <ListView
                            x:Name="ToolbarLayoutListView"
                            Padding="10"
                            AllowDrop="True"
                            AutomationProperties.AutomationId="ToolbarLayoutListView"
                            CanDragItems="True"
                            CanReorderItems="True"
                            DragItemsCompleted="ToolbarLayoutListView_DragItemsCompleted"
                            DragItemsStarting="ToolbarLayoutListView_DragItemsStarting"
                            IsSwipeEnabled="True"
                            SelectionMode="None" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer
            x:Name="DesktopCountdownContentScroller"
            Grid.Row="1"
            Canvas.ZIndex="2"
            Padding="18,4,18,32"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            SizeChanged="DesktopCountdownContentScroller_SizeChanged"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto"
            Visibility="Collapsed">
            <StackPanel
                x:Name="DesktopCountdownContentPanel"
                MaxWidth="640"
                MinWidth="360"
                HorizontalAlignment="Center"
                Spacing="24">
                <StackPanel Spacing="16">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="DesktopCountdownBackButton"
                            Width="36"
                            Height="36"
                            Padding="0"
                            AutomationProperties.AutomationId="DesktopCountdownBackButton"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="DesktopCountdownBackButton_Click">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                FontSize="16"
                                Glyph="&#xE72B;" />
                        </Button>
                        <TextBlock
                            x:Name="DesktopCountdownPageTitleText"
                            VerticalAlignment="Center"
                            FontSize="22"
                            FontWeight="SemiBold" />
                    </StackPanel>

                    <Border
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="6">
                        <Grid Padding="16" RowSpacing="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Grid.Column="0"
                                Grid.RowSpan="2"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                FontSize="20"
                                Glyph="&#xE7F4;"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="DesktopCountdownTitleText"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="DesktopCountdownTitleText"
                                FontWeight="SemiBold"
                                TextWrapping="WrapWholeWords" />
                            <TextBlock
                                x:Name="DesktopCountdownDescriptionText"
                                Grid.Row="1"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="DesktopCountdownDescriptionText"
                                HorizontalAlignment="Left"
                                MaxWidth="440"
                                Opacity="0.72"
                                TextWrapping="WrapWholeWords" />
                            <ToggleSwitch
                                x:Name="DesktopCountdownToggle"
                                Grid.Column="2"
                                Grid.RowSpan="2"
                                Margin="16,0,0,0"
                                AutomationProperties.AutomationId="DesktopCountdownToggle"
                                MinWidth="0"
                                OffContent=""
                                OnContent=""
                                VerticalAlignment="Center"
                                Toggled="DesktopCountdownToggle_Toggled" />
                        </Grid>
                    </Border>

                    <InfoBar
                        x:Name="DesktopCountdownExperimentalInfoBar"
                        AutomationProperties.AutomationId="DesktopCountdownExperimentalInfoBar"
                        IsClosable="False"
                        IsOpen="True"
                        Severity="Informational" />

                    <StackPanel
                        x:Name="DesktopCountdownOptionsPanel"
                        Spacing="8">
                        <TextBlock
                            x:Name="DesktopCountdownPlacementHeaderText"
                            FontSize="14"
                            FontWeight="SemiBold" />
                        <Border
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            CornerRadius="6">
                            <StackPanel
                                Padding="16"
                                Spacing="12">
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        x:Name="AdjustDesktopCountdownButton"
                                        Click="AdjustDesktopCountdownButton_Click" />
                                    <Button
                                        x:Name="ResetDesktopCountdownPositionButton"
                                        Click="ResetDesktopCountdownPositionButton_Click" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="DesktopCountdownAdjustHintText"
                                    MaxWidth="560"
                                    Opacity="0.72"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel
                        x:Name="DesktopCountdownStylePanel"
                        AutomationProperties.AutomationId="DesktopCountdownStylePanel"
                        Spacing="8">
                        <TextBlock
                            x:Name="DesktopCountdownStyleHeaderText"
                            FontSize="14"
                            FontWeight="SemiBold" />
                        <Expander
                            x:Name="DesktopCountdownStyleExpander"
                            AutomationProperties.AutomationId="DesktopCountdownStyleExpander"
                            HorizontalAlignment="Stretch"
                            IsExpanded="False">
                            <Expander.Header>
                                <Grid MinHeight="56">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Grid.Column="0"
                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                        FontSize="18"
                                        Glyph="&#xE943;"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        x:Name="DesktopCountdownStyleTitleText"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold" />
                                </Grid>
                            </Expander.Header>
                            <StackPanel
                                Padding="56,0,16,18"
                                Spacing="12">
                                <TextBlock
                                    x:Name="DesktopCountdownStyleDescriptionText"
                                    Opacity="0.72"
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    x:Name="DesktopCountdownStyleTemplatesHeaderText"
                                    FontSize="13"
                                    FontWeight="SemiBold" />
                                <StackPanel
                                    x:Name="DesktopCountdownStyleTemplatesPanel"
                                    AutomationProperties.AutomationId="DesktopCountdownStyleTemplatesPanel"
                                    Spacing="8" />
                                <TextBox
                                    x:Name="DesktopCountdownCssTextBox"
                                    AutomationProperties.AutomationId="DesktopCountdownCssTextBox"
                                    Height="180"
                                    AcceptsReturn="True"
                                    FontFamily="Cascadia Mono, Consolas"
                                    TextChanged="DesktopCountdownCssTextBox_TextChanged"
                                    TextWrapping="NoWrap" />
                                <Button
                                    x:Name="ResetDesktopCountdownStyleButton"
                                    AutomationProperties.AutomationId="ResetDesktopCountdownStyleButton"
                                    HorizontalAlignment="Left"
                                    Click="ResetDesktopCountdownStyleButton_Click" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
